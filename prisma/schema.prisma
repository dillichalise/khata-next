generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views", "prismaSchemaFolder"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // uses connection pooling
  directUrl = env("DIRECT_URL") // uses a direct connection
}

enum UserType {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  LOAN
  INTEREST
  LOAN_RETURN
  FINE
  MONTHLY_SAVING
}

enum TransactionAction {
  DEPOSIT
  WITHDRAW
}

model User {
  id           Int           @id @default(autoincrement())
  clerkUserId  String        @unique @map("clerk_user_id") // Clerk's userId
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  email        String        @unique
  phoneNumber  String        @unique @map("phone_number")
  role         UserType      @default(USER)
  status       UserStatus    @default(INACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]

  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model Transaction {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  date      DateTime
  action    TransactionAction
  type      TransactionType
  amount    Decimal           @db.Decimal(10, 2)
  remarks   String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("transactions")
}

view UserSummary {
  userId            Int     @unique @map("user_id")
  fullName          String  @map("full_name")
  totalSavings      Decimal @map("total_savings") @db.Decimal
  totalInterestPaid Decimal @map("total_interest_paid") @db.Decimal
  totalFinePaid     Decimal @map("total_fine_paid") @db.Decimal
  remainingLoan     Decimal @map("remaining_loan") @db.Decimal(10, 2)

  @@map("user_summary")
}
